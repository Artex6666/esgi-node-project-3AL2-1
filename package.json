{
  "name": "esgi-cinema-api",
  "version": "0.1.0",
  "private": true,
  "description": "Cinema management REST API",
  "type": "module",
  "engines": {
    "node": ">=25"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@scalar/express-api-reference": "^0.9.13",
    "argon2": "^0.44.0",
    "express": "^5.2.1",
    "express-zod-api": "^27.2.6",
    "http-errors": "^2.0.1",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "zod": "~4.3.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/http-errors": "^2.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vitest": "^4.1.5"
  }
}

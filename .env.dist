# Copy to .env and fill in real values: cp .env.dist .env

# Runtime
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
LOG_LEVEL=debug

# Database (Prisma) — used from M2 onward
DATABASE_URL=postgresql://cinema:cinema@localhost:5432/cinema?schema=public

# Auth — used from M3 onward. JWT_SECRET must be >= 32 chars.
JWT_SECRET=change_me_to_a_real_random_secret_min_32_chars
JWT_ACCESS_TTL_SEC=300
JWT_REFRESH_TTL_SEC=604800

# NixOS-only escape hatch: uncomment if `prisma migrate` complains it
# can't fetch the linux-nixos engine prebuild.
# PRISMA_SCHEMA_ENGINE_BINARY=node_modules/@prisma/engines/schema-engine-debian-openssl-3.0.x
# PRISMA_QUERY_ENGINE_LIBRARY=node_modules/@prisma/engines/libquery_engine-debian-openssl-3.0.x.so.node

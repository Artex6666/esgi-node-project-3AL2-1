NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info

DATABASE_URL=postgresql://cinema:cinema@localhost:5432/cinema?schema=public

# Must be at least 32 chars. Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_chars
JWT_ACCESS_TTL_SEC=300
JWT_REFRESH_TTL_SEC=604800

TICKET_STANDARD_PRICE_CENTS=1000
TICKET_SUPER_PRICE_CENTS=8000

# Grafana admin credentials (production stack only). Bound to 127.0.0.1:3001 — tunnel
# with `ssh -L 3001:localhost:3001 <host>` to reach the UI.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me

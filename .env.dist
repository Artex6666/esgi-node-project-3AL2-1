# ─── Common (dev + prod) ────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Must be at least 32 chars. Generate with: `head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n'`
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_chars
JWT_ACCESS_TTL_SEC=300
JWT_REFRESH_TTL_SEC=604800

TICKET_STANDARD_PRICE_CENTS=1000
TICKET_SUPER_PRICE_CENTS=8000

# ─── Dev (`docker compose up -d` + `npm run dev`) ───────────────────────────
# Postgres is exposed on the host via docker-compose.yml; password is fixed
# at `cinema` for local convenience. PUBLIC_URL points at the dev API.
PUBLIC_URL=http://localhost:3000
DATABASE_URL=postgresql://cinema:cinema@localhost:5432/cinema?schema=public

# ─── Prod (docker-compose.prod.yml — typically copied to .env.prod) ─────────
# These are required when bringing up the prod stack:
#
#   POSTGRES_PASSWORD  → init password for the prod Postgres (set on first run only)
#   DATABASE_URL       → must use host `postgres` (docker network), not localhost
#   PUBLIC_HOST        → Caddy site address. Examples:
#                          ":8080"                  plain HTTP on port 8080
#                          ":80"                    plain HTTP on port 80
#                          "cinema.example.com"     auto-HTTPS via Let's Encrypt
#   PUBLIC_URL         → external URL clients use (matches PUBLIC_HOST/scheme)
#   GRAFANA_ADMIN_PASSWORD → admin password for Grafana on :3001 (publicly bound)
#   SEED_FORCE         → "1" forces re-seed even if Room table is non-empty (default "0")
#
# Example values for a local prod test:
# POSTGRES_USER=cinema
# POSTGRES_PASSWORD=change_me_to_a_strong_db_password
# POSTGRES_DB=cinema
# DATABASE_URL=postgresql://cinema:change_me_to_a_strong_db_password@postgres:5432/cinema?schema=public
# PUBLIC_URL=http://localhost:8080
# PUBLIC_HOST=:8080
# SEED_FORCE=0

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_to_a_strong_password
